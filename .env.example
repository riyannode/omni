# Required for paid routes
SELLER_ADDRESS=0x0000000000000000000000000000000000000000

# Production: Circle MAINNET facilitator (also the SDK default).
CIRCLE_FACILITATOR_URL=https://gateway-api.circle.com
# Isolated testnet development only, never production:
# CIRCLE_FACILITATOR_URL=https://gateway-api-testnet.circle.com

PORT=3000
PUBLIC_BASE_URL=https://omni.example.com

# Production scale: configure both. OMNI still boots without them for local development.
DATABASE_URL=postgresql://omni:omni@postgres:5432/omni
REDIS_URL=redis://valkey:6379

# Per-replica backpressure. Put a load balancer/autoscaler in front for large concurrency.
MAX_IN_FLIGHT=512
UPSTREAM_TIMEOUT_MS=3000
UPSTREAM_MAX_IN_FLIGHT=256
UPSTREAM_MAX_QUEUE=2048

# Optional ordered CISA KEV feed override. Left empty, OMNI tries cisa.gov first and then the
# cisagov/kev-data mirror, because some egress IP ranges receive HTTP 403 from www.cisa.gov.
OMNI_KEV_FEED_URLS=

# ERC-8004 identity/reputation RPCs are separate from the Circle/x402 payment chain.
# HTTPS RPC endpoints are required; no provider credentials belong in this file.
# Ethereum Mainnet and Base Mainnet are the default production identity chains.
# No Arc Mainnet ERC-8004 support is claimed.
ERC8004_RPC_OVERRIDE_1=
ERC8004_RPC_OVERRIDE_8453=
# Sepolia is available only when OMNI_ERC8004_ENABLE_TESTNETS=true; it is not a production default.
OMNI_ERC8004_ENABLE_TESTNETS=false
ERC8004_RPC_OVERRIDE_11155111=
# Safe default: no trusted reviewers or recognized reputation tags.
OMNI_AGENT_REPUTATION_POLICY_JSON={}

# Optional server-side GitHub token for higher read-rate limits on repository evidence.
# Never return or log this value.
GITHUB_TOKEN=
