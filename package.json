{
  "name": "omni",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun --sql-preconnect src/index.ts",
    "worker": "bun --sql-preconnect src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "db:init": "bun db/init.ts",
    "load:unpaid": "bun scripts/load-unpaid.ts",
    "threats:import": "bun scripts/import-threat-intel.ts"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "3.3.0",
    "@x402/core": "2.21.0",
    "@x402/evm": "2.21.0",
    "express": "5.2.1",
    "viem": "2.55.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
